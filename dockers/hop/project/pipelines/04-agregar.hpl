<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>04-agregar</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Agrega por departamento y carrera. Group by exige la entrada ordenada por los campos de agrupacion.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/09 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/09 10:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>70</height>
      <xloc>336</xloc>
      <yloc>260</yloc>
      <note>Group by exige la entrada ORDENADA por los
campos de agrupacion. Sacar el Sort de al lado
y ejecutar: aparecen grupos repetidos.</note>
      <width>400</width>
    </notepad>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>70</height>
      <xloc>736</xloc>
      <yloc>260</yloc>
      <note>materias_totales y alumnos son enteros:
sin este casteo la division seria entera
y 326/26 daria 12 en vez de 12,54.</note>
      <width>380</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Inscripciones enriquecidas</from>
      <to>Ordenar por carrera</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ordenar por carrera</from>
      <to>Resumir</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Resumir</from>
      <to>Materias a decimal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Materias a decimal</from>
      <to>Materias por alumno</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Materias por alumno</from>
      <to>Resumen por carrera</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Inscripciones enriquecidas</name>
    <type>CSVInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_HOME}/salida/03-inscripciones-enriquecidas.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <schemaDefinition/>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>legajo</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>apellido_nombre</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>departamento</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>carrera</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>sede</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>sexo</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>fecha_inscripcion</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal></decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>materias_aprobadas</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal></decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>promedio</name>
        <type>Number</type>
        <format>#.##</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ordenar por carrera</name>
    <type>SortRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compress>N</compress>
    <directory>${java.io.tmpdir}</directory>
    <fields>
      <field>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <name>departamento</name>
        <presorted>N</presorted>
      </field>
      <field>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <name>carrera</name>
        <presorted>N</presorted>
      </field>
    </fields>
    <sort_prefix>out</sort_prefix>
    <sort_size>1000000</sort_size>
    <unique_rows>N</unique_rows>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Resumir</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <add_linenr>N</add_linenr>
    <all_rows>N</all_rows>
    <directory>${java.io.tmpdir}</directory>
    <fields>
      <field>
        <aggregate>alumnos</aggregate>
        <subject>legajo</subject>
        <type>COUNT_ALL</type>
      </field>
      <field>
        <aggregate>materias_totales</aggregate>
        <subject>materias_aprobadas</subject>
        <type>SUM</type>
      </field>
      <field>
        <aggregate>promedio_general</aggregate>
        <subject>promedio</subject>
        <type>AVERAGE</type>
      </field>
      <field>
        <aggregate>promedio_maximo</aggregate>
        <subject>promedio</subject>
        <type>MAX</type>
      </field>
    </fields>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>departamento</name>
      </field>
      <field>
        <name>carrera</name>
      </field>
    </group>
    <ignore_aggregate>N</ignore_aggregate>
    <prefix>grp</prefix>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Materias a decimal</name>
    <type>SelectValues</type>
    <description>Sin este casteo la division de abajo seria entera: 326/26 daria 12 y no 12,54.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <meta>
        <name>materias_totales</name>
        <rename/>
        <type>Number</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>#.##</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>736</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Materias por alumno</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <calculation>
      <calc_type>DIVIDE</calc_type>
      <field_a>materias_totales</field_a>
      <field_b>alumnos</field_b>
      <field_name>materias_por_alumno</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <value_type>Number</value_type>
    </calculation>
    <failIfNoFile>Y</failIfNoFile>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Resumen por carrera</name>
    <type>TextFileOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <schema_definition/>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${PROJECT_HOME}/salida/04-resumen-por-carrera</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field>
        <name>departamento</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>carrera</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>alumnos</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>materias_totales</name>
        <type>Number</type>
        <format>0.##</format>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>promedio_general</name>
        <type>Number</type>
        <format>0.00</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>promedio_maximo</name>
        <type>Number</type>
        <format>0.00</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>materias_por_alumno</name>
        <type>Number</type>
        <format>0.00</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
